{
  "manifest_version": "0.2",
  "name": "sms-florin-mcp",
  "version": "0.1.2",
  "description": "MCP server for sms-florin — lets AI coding agents (Claude, Cursor, Codex, Windsurf...) rent a real UK phone number and receive SMS/OTP verification codes during automated testing.",
  "author": {
    "name": "sms-florin"
  },
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "SMS_FLORIN_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "sms-florin API Key",
      "description": "Get one at https://flo-voice1.com/api-access",
      "sensitive": true,
      "required": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flovoice53-tech/sms-florin-mcp"
  },
  "homepage": "https://flo-voice1.com/api-access"
}
